@model IEnumerable<MasterEF.Student>

@{
    ViewData["Title"] = "Student List";
}

<h2>Student Directory</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Student</a>
</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["UploadedPath"] != null)
{
    <p>
        <a asp-action="Download" asp-route-path="@TempData["UploadedPath"]" class="btn btn-outline-primary">Download uploaded file</a>
    </p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentName</td>
                <td>@item.StudentEmail</td>
                <td>@item.StudentPhone</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-warning btn-sm">Edit</a>
                    <form asp-action="DeleteConfirmed" asp-route-id="@item.StudentId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

